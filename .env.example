# Copy to .env.local for local dev, and paste the same values into
# Vercel > Project > Settings > Environment Variables before deploying.

# Supabase > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > service_role
# SECRET. Never prefix with NEXT_PUBLIC_ or it ends up in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# platform.openai.com > API Keys. Used to generate the cover, the CTA,
# and any story slide whose feed item had no usable photo. Your OpenAI
# organization must be verified (Settings > Organization > Verify) or
# gpt-image-1 requests are rejected.
OPENAI_API_KEY=
