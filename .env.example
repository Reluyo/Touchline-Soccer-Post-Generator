# Copy to .env.local for local dev, and paste the same values into
# Vercel > Project > Settings > Environment Variables before deploying.

# Supabase > Project Settings > Data API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys > service_role
# SECRET. Never prefix with NEXT_PUBLIC_ or it ends up in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# platform.openai.com > API Keys. Used to generate the cover and any
# story/result slide that needs an image. Your OpenAI organization
# must be verified (Settings > Organization > Verify) or gpt-image-1
# requests are rejected. The CTA slide uses one fixed image, not this.
OPENAI_API_KEY=

# football-data.org > free API key (sign up at football-data.org/client/register).
# Used only for Results posts -- finished matches from the last 7 days
# across the big-five leagues and the Champions League.
FOOTBALL_DATA_API_KEY=

# Google Programmable Search Engine (programmablesearchengine.google.com):
# create a search engine with "Search the entire web" and "Image search"
# both turned on, then grab its Search engine ID (cx) from its Overview
# page. GOOGLE_CSE_API_KEY comes from console.cloud.google.com > APIs &
# Services > Credentials, with the "Custom Search API" enabled on that
# project. Free tier is 100 queries/day, then paid. Used to find a real
# photo for a News story slide whose feed item had no usable image,
# before falling back to AI generation -- see lib/imageSearch.js. These
# are real, copyrighted press photos with no license for this use, a
# knowingly-accepted tradeoff -- see README.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
